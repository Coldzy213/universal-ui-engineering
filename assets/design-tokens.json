      "successText": { "$type": "color", "$value": "#166534" },
      "warningText": { "$type": "color", "$value": "#92400E" }
    },
    "dark": {
      "canvas": { "$type": "color", "$value": "#0B1220" },
      "surface": { "$type": "color", "$value": "#151F30" },
      "textPrimary": { "$type": "color", "$value": "#F8FAFC" },
      "textSecondary": { "$type": "color", "$value": "#CBD5E1" },
      "borderSubtle": { "$type": "color", "$value": "#475569" },
      "borderStrong": { "$type": "color", "$value": "#94A3B8" },
      "action": { "$type": "color", "$value": "#93C5FD" },
      "actionHover": { "$type": "color", "$value": "#BFDBFE" },
