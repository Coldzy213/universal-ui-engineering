    "pageTitle": { "$type": "dimension", "$value": "32px" },
    "metric": { "$type": "dimension", "$value": "30px" }
  },
  "color": {
    "light": {
      "canvas": { "$type": "color", "$value": "#F8FAFC" },
      "surface": { "$type": "color", "$value": "#FFFFFF" },
      "textPrimary": { "$type": "color", "$value": "#0F172A" },
      "textSecondary": { "$type": "color", "$value": "#475569" },
      "borderSubtle": { "$type": "color", "$value": "#CBD5E1" },
      "borderStrong": { "$type": "color", "$value": "#64748B" },
      "action": { "$type": "color", "$value": "#1D4ED8" },
      "actionHover": { "$type": "color", "$value": "#1E40AF" },
      "onAction": { "$type": "color", "$value": "#FFFFFF" },
